# ============================================================================
# BACKEND ENVIRONMENT VARIABLES - Masjid Al-Mi'raj
# ============================================================================
# SALIN file ini menjadi ".env" dan isi nilai sebenarnya.
# JANGAN PERNAH commit file .env!

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# URL frontend yang diizinkan mengakses API (pisahkan dengan koma)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Dapatkan dari dashboard Neon: Connection string / "postgres://..."
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
PGSSLMODE=require

# ---------------------------------------------------------------------------
# JWT (Authentication)
# ---------------------------------------------------------------------------
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_secret_acak_yang_panjang_minimal_64_karakter
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=ganti_dengan_refresh_secret_acak_yang_lain
JWT_REFRESH_EXPIRES_IN=7d
# Nama cookie untuk refresh token
COOKIE_NAME=masjid_refresh_token
# Set 'true' jika pakai HTTPS (production)
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# FILE UPLOAD
# ---------------------------------------------------------------------------
# Lokasi penyimpanan file (relatif terhadap folder backend)
UPLOAD_DIR=uploads
# Ukuran maksimal upload dalam bytes (default 10MB)
MAX_FILE_SIZE=10485760
# CATATAN: di Vercel/Netlify filesystem bersifat read-only (kecuali /tmp).
#   Untuk production gunakan storage eksternal (Cloudinary/S3/R2) dengan
#   men-set USE_CLOUD_STORAGE=true dan variable storage-nya.
USE_CLOUD_STORAGE=false

# ---------------------------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
LOG_LEVEL=dev
