{
  "name": "masjid-al-miraj-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RESTful API Sistem Manajemen Masjid Al-Mi'raj (Express + Neon PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo \"Backend adalah Node app, tidak perlu build. Deploy ke Vercel/Netlify via output API.\"",
    "db:migrate": "node src/utils/migrateDb.js",
    "db:seed": "node src/utils/seedDb.js",
    "db:reset": "node src/utils/migrateDb.js && node src/utils/seedDb.js",
    "lint": "echo \"(opsional) jalankan: npx eslint src/ \""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
