# Frontend Environment Variables
# Salin menjadi ".env" (Vite hanya membaca variable berawalan VITE_)

# URL backend API.
# - Development (via proxy Vite): biarkan kosong atau "/api"
# - Production: isi URL lengkap, mis. https://api.masjidalmiraj.sch.id/api
VITE_API_URL=/api

# Nama aplikasi (tampil di header/footer)
VITE_APP_NAME=Sistem Manajemen Masjid Al-Mi'raj
